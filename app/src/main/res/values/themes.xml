<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.EthWallet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#ffffff</item>
        <item name="windowSplashScreenBackground">#ffffff</item>

        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Below API 28 androidx.biometric shows its prompt in an AppCompat AlertDialog, which
             crashes unless this platform theme points it at an AppCompat dialog theme. -->
        <item name="alertDialogTheme">@style/Theme.AppCompat.Light.Dialog.Alert</item>
    </style>
</resources>